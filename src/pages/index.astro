---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Story from "../components/Story.astro";
import Programs from "../components/Programs.astro";
import Director from "../components/Director.astro";
import Impact from "../components/Impact.astro";
import Gallery from "../components/Gallery.astro";
import Stories from "../components/Stories.astro";
import GetInvolved from "../components/GetInvolved.astro";
import Donate from "../components/Donate.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import ContentChecklist from "../components/ContentChecklist.astro";
---

<Layout>
  <Header />
  <main id="main">
    <Hero />
    <About />
    <Story />
    <Programs />
    <Director />
    {/* Impact and Stories render only once there is real content for them. */}
    <Impact />
    <Gallery />
    <Stories />
    <GetInvolved />
    <Donate />
    <Contact />
  </main>
  <Footer />
  <ContentChecklist />
</Layout>
