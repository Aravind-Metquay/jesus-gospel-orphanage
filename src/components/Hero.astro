---
import { Image } from "astro:assets";
import { hero, org } from "../data/site";

/* Drop a wide photo at src/assets/hero.jpg and it appears here, compressed and
   resized by Astro. Until then the panel shows the brand colours on their own. */
const found = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/hero.{jpg,jpeg,png,webp,avif}",
  { eager: true }
);
const photo = Object.values(found)[0]?.default;
---

<section class="hero">
  {
    photo ? (
      <Image
        class="hero__photo"
        src={photo}
        alt={hero.imageAlt}
        widths={[640, 1024, 1600, 2000]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <div class="hero__photo hero__photo--empty" aria-hidden="true">
        <span>Hero photo goes here &mdash; src/assets/hero.jpg</span>
      </div>
    )
  }

  <div class="hero__scrim"></div>

  <div class="wrap hero__inner">
    <p class="hero__kicker">{org.name} &middot; Reg. No. {org.regNo}</p>
    <h1>{hero.heading}</h1>
    <p class="hero__sub">{hero.sub}</p>
    <div class="btn-row">
      <a class="btn btn--gold" href="#donate">Donate</a>
      <a class="btn btn--onnavy" href="#get-involved">Sponsor a Child</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--navy);
    color: var(--cream);
    min-height: clamp(26rem, 62vh, 38rem);
    display: flex;
    align-items: flex-end;
  }

  .hero__photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__photo--empty {
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 100% at 20% 0%, var(--navy-500) 0%, transparent 60%),
      linear-gradient(160deg, var(--navy-700) 0%, var(--navy) 70%);
    color: rgba(232, 213, 163, 0.6);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-align: center;
    padding: 1rem;
  }

  /* Keeps the headline readable whatever the photo turns out to be. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgba(10, 30, 59, 0.72) 0%,
      rgba(10, 30, 59, 0.6) 40%,
      rgba(10, 30, 59, 0.92) 100%
    );
  }

  .hero__inner { padding-block: clamp(3rem, 9vw, 5.5rem); }

  .hero__kicker {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.9rem;
  }

  .hero h1 { color: var(--cream); max-width: 18ch; }

  .hero__sub {
    font-size: var(--step-1);
    color: var(--gold-soft);
    max-width: 46ch;
    margin-bottom: 1.9rem;
  }
</style>
