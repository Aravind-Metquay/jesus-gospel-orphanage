---
import { stories } from "../data/site";

/* Same rule as Impact: real quotes with permission, or nothing. */
const items = stories.items.filter((s) => s.quote?.trim());
---

{
  items.length > 0 && (
    <section class="section section--tint" id="stories">
      <div class="wrap">
        <div class="section__head">
          <span class="eyebrow">{stories.eyebrow}</span>
          <h2>{stories.heading}</h2>
        </div>

        <ul class="quotes">
          {items.map((item) => (
            <li>
              <figure>
                <blockquote><p>{item.quote}</p></blockquote>
                <figcaption>
                  <strong>{item.name}</strong>
                  <span>{item.role}</span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .quotes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(1rem, 3vw, 1.75rem);
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }

  figure {
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    background: #fff;
    border-radius: var(--radius);
    padding: clamp(1.4rem, 3vw, 1.9rem);
    box-shadow: var(--shadow);
  }

  blockquote { margin: 0; flex: 1; }

  blockquote p {
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.55;
    margin: 0;
  }

  blockquote p::before { content: "\201C"; color: var(--gold); }
  blockquote p::after { content: "\201D"; color: var(--gold); }

  figcaption { display: flex; flex-direction: column; gap: 0.1rem; }
  figcaption strong { font-weight: 600; }
  figcaption span { font-size: var(--step--1); color: var(--ink); }
</style>
