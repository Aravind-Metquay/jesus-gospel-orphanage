---
import { donate, org } from "../data/site";

const rows = [
  { label: "Account name", value: donate.bank.accountName },
  { label: "Account number", value: donate.bank.accountNumber },
  { label: "Bank & branch", value: donate.bank.bank },
  { label: "IFSC", value: donate.bank.ifsc },
  { label: "UPI", value: donate.bank.upi },
].filter((row) => row.value.trim());
---

<section class="section section--cream" id="donate">
  <div class="wrap donate">
    <div>
      <span class="eyebrow">{donate.eyebrow}</span>
      <h2>{donate.heading}</h2>
      <p class="lede">{donate.sub}</p>
      <p class="note">{donate.note}</p>
      <p class="note">
        Registered public charitable trust &mdash; <strong>Reg. No. {org.regNo}</strong>.
      </p>
    </div>

    <div class="panel">
      <h3>Bank transfer</h3>
      <dl>
        {rows.map((row) => (
          <div class="row">
            <dt>{row.label}</dt>
            <dd>{row.value}</dd>
          </div>
        ))}
      </dl>
      <a class="btn btn--gold" href="#contact">Questions? Talk to us</a>
    </div>
  </div>
</section>

<style>
  .donate { display: grid; gap: clamp(2rem, 5vw, 3.5rem); align-items: start; }

  .lede { font-size: var(--step-1); color: var(--ink); }
  .note { font-size: 0.95rem; color: var(--ink); }

  .panel {
    background: var(--navy);
    color: var(--cream);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 4vw, 2.25rem);
    box-shadow: var(--shadow);
  }

  .panel h3 { color: var(--gold); margin-top: 0; }

  dl { margin: 0 0 1.75rem; display: grid; gap: 0.9rem; }

  .row + .row { border-top: 1px solid rgba(232, 213, 163, 0.2); padding-top: 0.9rem; }

  dt {
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
  }

  /* Account numbers and IFSC codes get read digit by digit — keep them monospaced
     and let long values wrap rather than overflow on a phone. */
  dd {
    margin: 0.15rem 0 0;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 0.98rem;
    overflow-wrap: anywhere;
  }

  @media (min-width: 56rem) {
    .donate { grid-template-columns: minmax(0, 1fr) minmax(20rem, 26rem); }
  }
</style>
